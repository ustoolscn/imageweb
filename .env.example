# Image Web 配置模板
# 复制为 .env 后修改；.env 不要提交到仓库。

# 后端 HTTP 监听端口。
# Docker Compose 默认把宿主机同端口映射到容器 8080；如果改成 9000，访问地址就是 http://localhost:9000。
PORT=8080

# MySQL 连接串，当前项目只支持 MySQL 8.0+。
# 使用远程数据库部署时必填；Docker 容器内的 localhost 指的是容器自己，不是宿主机。
# 如果使用内置 MySQL，请用 docker-compose.mysql.yml 叠加部署，它会覆盖这个值。
# 远程数据库示例：user:password@tcp(host:3306)/image_web?parseTime=true&charset=utf8mb4&loc=UTC
# 本机直接 go run 示例：user:password@tcp(localhost:3306)/image_web?parseTime=true&charset=utf8mb4&loc=UTC
DATABASE_DSN=user:password@tcp(host:3306)/image_web?parseTime=true&charset=utf8mb4&loc=UTC

# 用于加密保存用户传入的上游 API Key；后端缺少该值会拒绝启动。
# 生产环境请改成随机长字符串，并在重建容器/升级时保持不变，否则历史任务无法解密继续运行。
APP_CREDENTIAL_KEY=change-me-to-a-random-secret-at-least-32-chars

# 内置图库只支持阿里云 OSS。用户本地上传会用前端提供的 SHA-256 在 MySQL 中查重；
# AI 生成素材会直接上传到 OSS；用户提供的 URL 素材不会转存。
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://files.example.com
OSS_PREFIX=imageweb
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# 图库管理页面账号。密码为空时图库管理登录不可用。
GALLERY_ADMIN_USERNAME=admin
GALLERY_ADMIN_PASSWORD=change-me
GALLERY_SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
